---
import { SITE } from "../config";
const { nome, frequenza, buttondownUsername: u } = SITE.newsletter;
const action = u ? `https://buttondown.com/api/emails/embed-subscribe/${u}` : undefined;
---
<section id="newsletter" class="box">
  <h2>{nome}</h2>
  <p class="mono freq">{frequenza}</p>
  <p>Un log di sviluppo via email. Cosa ho provato, cosa si è rotto, i numeri veri. In italiano, niente hype.</p>
  <form action={action} method="post">
    <label for="email-nl">Indirizzo email</label>
    <div class="row">
      <input id="email-nl" type="email" name="email" placeholder="tu@esempio.it" required autocomplete="email" />
      <button type="submit" class="go">Iscriviti</button>
    </div>
  </form>
  {!u && <p class="mono soon">Newsletter in arrivo</p>}
</section>
<style>
  .box { background: var(--accent); color: var(--bg); border-radius: 12px; padding: 28px; margin: 40px 0; }
  .box h2 { color: var(--bg); font-size: 28px; font-weight: 600; margin-bottom: 4px; }
  .box p { color: var(--bg); }
  .freq { margin: 0 0 12px; }
  label { display: block; font-size: 14px; margin-bottom: 6px; }
  .row { display: flex; gap: 10px; }
  input { flex: 1; min-width: 0; height: 48px; border-radius: 10px; border: 1px solid var(--bg); padding: 0 14px; font: 16px var(--sans); background: var(--bg); color: var(--ink); }
  .go { height: 48px; padding: 0 22px; border-radius: 10px; border: 0; background: var(--bg); color: var(--accent); font: 600 16px var(--sans); cursor: pointer; }
  .box :focus-visible { outline-color: var(--bg); }
  .soon { margin: 12px 0 0; }
  @media (max-width: 640px) { .row { flex-direction: column; } }
</style>
