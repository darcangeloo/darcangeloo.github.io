---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/500-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";

interface Props {
  title?: string; description?: string; image?: string; noindex?: boolean;
  type?: "website" | "article"; publishedDate?: Date; schema?: object[];
}
const { title, description = SITE.descrizione, image = "/og.png", noindex = false, type = "website", publishedDate, schema } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.nome}` : SITE.titolo;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="application/rss+xml" title={SITE.titolo} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd extra={schema} />
  </head>
  <body>
    <div class="wrap">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #F7F5EF; --ink: #1C1B18; --text: #3D3A33; --muted: #5E5A50;
    --line: #E3DFD4; --accent: #1F5F4A; --accent-soft: #DCE6E0;
    --serif: "Newsreader", Georgia, serif;
    --sans: "IBM Plex Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 16px/1.6 var(--sans); }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  a { color: var(--accent); }
  h1, h2, h3 { font-family: var(--serif); color: var(--ink); font-weight: 500; margin: 0; }
  p { margin: 0 0 1em; }
  section { padding: 40px 0; }
  section > h2 {
    font-size: 28px; color: var(--accent); font-weight: 600;
    padding-bottom: 8px; border-bottom: 2px solid var(--accent); margin-bottom: 24px;
  }
  .mono { font-family: var(--mono); font-size: 13px; }
  .muted { color: var(--muted); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; height: 48px; padding: 0 22px;
    border-radius: 10px; border: 1px solid var(--accent); background: var(--accent); color: var(--bg);
    font: 600 16px var(--sans); text-decoration: none; cursor: pointer;
  }
  .btn.outline { background: transparent; color: var(--accent); }
  .card { border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 640px) { section { padding: 32px 0; } }
</style>
