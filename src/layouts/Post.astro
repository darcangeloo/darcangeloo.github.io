---
import Base from "./Base.astro";
import Newsletter from "../components/Newsletter.astro";

interface Props { title: string; description: string; date: Date }
const { title, description, date } = Astro.props;
---
<Base title={title} description={description}>
  <article>
    <p class="mono muted"><a href="/log/">← Log</a> · <time datetime={date.toISOString()}>{date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" })}</time></p>
    <h1>{title}</h1>
    <div class="body"><slot /></div>
  </article>
  <Newsletter />
</Base>
<style>
  article { padding-top: 32px; }
  h1 { font-size: 40px; line-height: 1.15; margin: 8px 0 24px; }
  .body { font-size: 18px; line-height: 1.7; }
  .body :global(h2) { font-size: 28px; margin: 1.6em 0 .5em; }
  .body :global(h3) { font-size: 22px; margin: 1.4em 0 .5em; }
  .body :global(pre) { overflow-x: auto; padding: 16px; border: 1px solid var(--line); border-radius: 12px; font: 14px/1.5 var(--mono); }
  .body :global(code) { font-family: var(--mono); font-size: .9em; }
  .body :global(img) { max-width: 100%; height: auto; }
  .body :global(blockquote) { margin: 0 0 1em; padding-left: 16px; border-left: 2px solid var(--line); color: var(--muted); }
  @media (max-width: 640px) { h1 { font-size: 30px; } }
</style>
