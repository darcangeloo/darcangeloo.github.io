---
import { getCollection } from "astro:content";
import { SITE } from "../config";
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import Book from "../components/Book.astro";
import Services from "../components/Services.astro";

const posts = (await getCollection("log", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const social = [["GitHub", SITE.links.github], ["Hugging Face", SITE.links.huggingface], ["LinkedIn", SITE.links.linkedin], ["Email", `mailto:${SITE.email}`]];
---
<Base>
  <section class="hero">
    <div class="txt">
      <p class="mono muted">MACHINE LEARNING · {SITE.luogo}</p>
      <h1>{SITE.descrizione}</h1>
      <p>Sviluppatore, autore di <em>Insegnare alle Macchine</em>. Lavoro su modelli linguistici, MLOps e reinforcement learning.</p>
      <p class="mono links">{social.map(([t, h]) => <a href={h}>{t}</a>)}</p>
    </div>
    {SITE.foto
      ? <img src={SITE.foto} alt={`Foto di ${SITE.nome}`} width="148" height="148" />
      : <div class="ph mono" role="img" aria-label="Foto non ancora disponibile">[foto]</div>}
  </section>

  <Newsletter />

  <section id="log">
    <h2>Log</h2>
    <PostList posts={posts} />
    <p class="mono all"><a href="/log/">Tutti i post</a></p>
  </section>

  <section id="progetti"><h2>Progetti</h2><ProjectList /></section>
  <section id="libro"><h2>Libro</h2><Book /></section>
  <section id="lavora">
    <h2>Lavora con me</h2>
    <p>Prendo pochi progetti freelance alla volta, su cose in cui posso portare un risultato misurabile.</p>
    <Services />
    <a class="btn" href={`mailto:${SITE.email}`}>Scrivimi</a>
  </section>
</Base>
<style>
  .hero { display: flex; gap: 32px; align-items: flex-start; justify-content: space-between; }
  h1 { font-size: 52px; line-height: 1.1; margin: 8px 0 20px; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  img, .ph { width: 148px; height: 148px; border-radius: 50%; flex: none; object-fit: cover; }
  .ph { background: var(--accent-soft); color: var(--muted); display: flex; align-items: center; justify-content: center; }
  .all { margin-top: 16px; }
  @media (max-width: 640px) {
    .hero { flex-direction: column-reverse; }
    h1 { font-size: 34px; }
  }
</style>
