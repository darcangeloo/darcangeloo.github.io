---
import { SITE } from "../config";
import { getPublishedPosts } from "../lib/posts";
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import Book from "../components/Book.astro";
import Services from "../components/Services.astro";

const posts = (await getPublishedPosts()).slice(0, 3);
const social = [["GitHub", SITE.links.github], ["Hugging Face", SITE.links.huggingface], ["LinkedIn", SITE.links.linkedin], ["Email", `mailto:${SITE.email}`]];
// Mini scacchiera decorativa 4x4 (︎ forza il glifo testuale invece dell'emoji).
const mini = [
  ["", ""], ["♜︎", "b"], ["", ""], ["♚︎", "b"],
  ["♟︎", "b"], ["", ""], ["♟︎", "b"], ["", ""],
  ["", ""], ["", ""], ["♞︎", "w"], ["", ""],
  ["♟︎", "w"], ["", ""], ["♚︎", "w"], ["♜︎", "w"],
];
const person = { "@id": new URL("/#person", Astro.site).href };
const schema = [
  { "@type": "WebSite", name: SITE.titolo, url: Astro.site!.href, inLanguage: "it" },
  {
    "@type": "Book", name: SITE.libro.titolo, author: person, inLanguage: "it", numberOfPages: 185,
    ...(!SITE.libro.amazonUrl.includes("[") && { url: SITE.libro.amazonUrl }),
  },
];
---
<Base schema={schema}>
  <section class="hero">
    <div class="txt">
      <p class="mono muted">MACHINE LEARNING · {SITE.luogo}</p>
      <h1>{SITE.descrizione}</h1>
      <p>Sviluppatore, autore di <em>Insegnare alle Macchine</em>. Lavoro su modelli linguistici, MLOps e sto imparando reinforcement learning.</p>
      <p class="mono links">{social.map(([t, h]) => <a href={h}>{t}</a>)}</p>
    </div>
    {SITE.foto
      ? <img src={SITE.foto} alt={`Foto di ${SITE.nome}`} width="148" height="148" />
      : <div class="ph mono" role="img" aria-label="Foto non ancora disponibile">[foto]</div>}
  </section>

  <Newsletter />

  <section id="prova" aria-labelledby="prova-titolo">
    <div class="feature">
      <div class="copy">
        <p class="badge mono">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>
          Demo interattiva
        </p>
        <h2 id="prova-titolo">Prova Chess-GPT</h2>
        <p class="lead">Una partita a scacchi contro un modello da 41M parametri, allenato da zero su partite Lichess. Giochi col bianco, dal tuo browser.</p>
        <ul class="chips mono" aria-label="Caratteristiche del modello">
          <li>41M parametri</li><li>Allenato da zero</li><li>Dati Lichess</li>
        </ul>
        <p class="cta-row">
          <a class="cta" href="/demo/chess/">
            Gioca ora
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="more" href="/progetti/chess-gpt/">Scheda del progetto</a>
        </p>
        <p class="fine">Può giocare male, e il server di casa su cui gira può essere spento: in quel caso la demo risulta offline.</p>
      </div>
      <div class="mini" aria-hidden="true">
        {mini.map(([g, c], i) => (
          <span class={`mq ${(i % 4 + Math.floor(i / 4)) % 2 ? "d" : "l"}`}>
            {g && <span class={`mp ${c}`} style={`--i:${i}`}>{g}</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section id="log">
    <h2>Log</h2>
    {posts.length ? (
      <>
        <PostList posts={posts} />
        <p class="mono all"><a href="/log/">Tutti i post</a></p>
      </>
    ) : <p class="muted">Il primo post arriva a breve.</p>}
  </section>

  <section id="progetti"><h2>Progetti</h2><ProjectList /></section>
  <section id="libro"><h2>Libro</h2><Book /></section>
  <section id="lavora">
    <h2>Lavora con me</h2>
    <p>Prendo pochi progetti freelance alla volta, su cose in cui posso portare un risultato misurabile.</p>
    <Services />
    <a class="btn" href={`mailto:${SITE.email}`}>Scrivimi</a>
  </section>
</Base>
<style>
  .hero { display: flex; gap: 32px; align-items: flex-start; justify-content: space-between; }
  h1 { font-size: 52px; line-height: 1.1; margin: 8px 0 20px; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  img, .ph { width: 148px; height: 148px; border-radius: 50%; flex: none; object-fit: cover; }
  .ph { background: var(--accent-soft); color: var(--muted); display: flex; align-items: center; justify-content: center; }
  .all { margin-top: 16px; }

  /* sezione in evidenza: prova Chess-GPT */
  .feature {
    position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 28px;
    padding: 32px; border-radius: 16px; color: var(--bg);
    background: radial-gradient(120% 90% at 100% 0%, #2b7a60 0%, transparent 60%), var(--accent);
    box-shadow: 0 1px 2px rgba(28, 27, 24, .2), 0 18px 36px -16px rgba(31, 95, 74, .55);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .feature::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; transform: translateX(-120%);
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, .12) 50%, transparent 60%);
    transition: transform .9s ease;
  }
  .feature:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgba(28, 27, 24, .2), 0 26px 44px -16px rgba(31, 95, 74, .6); }
  .feature:hover::after { transform: translateX(120%); }
  .copy { position: relative; z-index: 1; min-width: 0; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; padding: 4px 12px 4px 10px;
    border-radius: 999px; background: rgba(247, 245, 239, .14); border: 1px solid rgba(247, 245, 239, .3);
  }
  .badge svg { width: 16px; height: 16px; }
  .feature h2 { color: var(--bg); font-size: 34px; line-height: 1.15; margin: 0 0 12px; padding: 0; border: 0; }
  .lead { font-size: 18px; line-height: 1.6; margin: 0 0 16px; max-width: 46ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; padding: 0; list-style: none; }
  .chips li { padding: 2px 10px; border-radius: 999px; border: 1px solid rgba(247, 245, 239, .35); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin: 0 0 16px; }
  .cta {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 24px; border-radius: 10px;
    background: var(--bg); color: var(--accent); font: 600 17px var(--sans); text-decoration: none;
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, .45);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .cta svg { width: 20px; height: 20px; transition: transform .2s ease; }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -8px rgba(0, 0, 0, .5); }
  .cta:hover svg { transform: translateX(4px); }
  .cta:active { transform: scale(.97); }
  .more { color: var(--bg); font-weight: 500; text-underline-offset: 4px; }
  .more:hover { text-decoration-thickness: 2px; }
  .fine { font-size: 14px; line-height: 1.5; margin: 0; opacity: .92; }
  .feature :focus-visible { outline-color: var(--bg); outline-offset: 3px; }

  .mini {
    position: relative; z-index: 1; flex: none; display: grid; grid-template-columns: repeat(4, 1fr);
    width: 176px; aspect-ratio: 1; border-radius: 8px; overflow: hidden;
    border: 2px solid rgba(247, 245, 239, .4); box-shadow: 0 16px 28px -10px rgba(0, 0, 0, .5);
    transform: rotate(-3deg); transition: transform .4s ease;
    container-type: inline-size;
  }
  .feature:hover .mini { transform: rotate(0deg) scale(1.03); }
  .mq { display: flex; align-items: center; justify-content: center; }
  .mq.l { background: #eff1e6; }
  .mq.d { background: #8daf9d; }
  .mp { font-size: 32px; font-size: 18cqw; line-height: 1; filter: drop-shadow(0 1.5px 1px rgba(28, 27, 24, .35)); animation: float 4s ease-in-out infinite; animation-delay: calc(var(--i) * -.37s); }
  .mp.w { color: #fff; -webkit-text-stroke: 1.2px var(--ink); paint-order: stroke fill; }
  .mp.b { color: var(--ink); }
  @keyframes float { 50% { transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) {
    .feature, .feature::after, .mini, .cta, .cta svg { transition: none; }
    .mp { animation: none; }
  }
  @media (max-width: 640px) {
    .hero { flex-direction: column-reverse; }
    h1 { font-size: 34px; }
    /* su telefono la scacchiera sta in alto, centrata, sopra il testo */
    .feature { flex-direction: column-reverse; align-items: flex-start; gap: 22px; padding: 24px 20px; }
    .feature h2 { font-size: 28px; }
    .mini { align-self: center; width: 132px; }
  }
</style>
